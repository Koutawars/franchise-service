	"item": [
		{
			"name": "Create franchise",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Extract 'id' from JSON response and save to environment var 'franchiseId'",
							"// Works for 200 responses; handles missing id gracefully.",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.expect(pm.response.code).to.eql(200);",
							"});",
							"",
							"let json;",
							"try {",
							"    json = pm.response.json();",
							"} catch (e) {",
							"    json = null;",
							"}",
							"",
							"pm.test(\"Extract and store franchiseId when available\", function () {",
							"    // Proceed only if status 200 and body is JSON",
							"    if (pm.response.code === 200 && json) {",
							"        // Support either top-level id or nested in data.id",
							"        const id = (json && (json.id || (json.data && json.data.id))) || null;",
							"",
							"        if (id) {",
							"            pm.environment.set('franchiseId', String(id));",
							"            pm.expect(pm.environment.get('franchiseId')).to.exist;",
							"        } else {",
							"            // Ensure we don't keep a stale value",
							"            pm.environment.unset('franchiseId');",
							"            pm.expect(true, \"Response JSON has no id to store\").to.be.true;",
							"        }",
							"    } else {",
							"        // Non-200 or non-JSON: do not fail the run; just skip storing",
							"        pm.expect(true, \"Skipping id storage due to non-200 or non-JSON response\").to.be.true;",
							"    }",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"MC Donalds\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{franchise_service}}/franchises",
					"host": [
						"{{franchise_service}}"
					],
					"path": [
						"franchises"
					]
				},
				"description": "This request retrieves a list of users from the JSONPlaceholder API."
			},
			"response": []
		},
		{
