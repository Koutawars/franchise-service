				{
					"listen": "test",
					"script": {
						"exec": [
							"// Extract branchId from response when status 200 and save to environment",
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"(function handleBranchIdExtraction() {",
							"  if (pm.response.code !== 200) {",
							"    console.log(\"Create branch: Skipping branchId save because status is\", pm.response.code);",
							"    return;",
							"  }",
							"  let body;",
							"  try {",
							"    body = pm.response.json();",
							"  } catch (e) {",
							"    console.log(\"Create branch: Response is not valid JSON, cannot extract id\");",
							"    return;",
							"  }",
							"",
							"  const branchId = body && body.data && body.data.id ? String(body.data.id) : null;",
							"",
							"  if (branchId) {",
							"    pm.environment.set(\"branchId\", branchId);",
							"    console.log(\"Create branch: Saved branchId to environment:\", branchId);",
							"  } else {",
							"    console.log(\"Create branch: 'data.id' not found in the response. Nothing saved.\");",
							"    // If you want the run to fail when id is missing, uncomment the test below",
							"    // pm.test(\"Response contains data.id\", function () { pm.expect(branchId, \"data.id should be present\").to.be.ok; });",
							"  }",
							"})();"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
